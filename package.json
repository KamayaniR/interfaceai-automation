{
  "name": "interfaceai-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Computer-use automation: LLM discovers a UI flow once, records it as a typed capability artifact, replays it deterministically.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "target-app": "tsx --env-file-if-exists=.env target-app/server.ts",
    "operator": "tsx --env-file-if-exists=.env src/escalation/console.ts",
    "discover": "tsx --env-file-if-exists=.env src/cli.ts discover",
    "replay": "tsx --env-file-if-exists=.env src/cli.ts replay",
    "catalog": "tsx --env-file-if-exists=.env src/cli.ts catalog",
    "test": "tsx --env-file-if-exists=.env --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "ask": "tsx --env-file-if-exists=.env src/cli.ts ask",
    "stability": "tsx --env-file-if-exists=.env src/cli.ts stability"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
