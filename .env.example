# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored and is loaded automatically by every npm script.
# Everything here has a working default EXCEPT the API key.

# ---------------------------------------------------------------------------
# Required for `npm run discover` only.
# ---------------------------------------------------------------------------
# Discovery is the one path that puts a model in the decision loop. Replay, the
# operator console, the capability catalog and the tests all run without a key,
# against the committed artifacts.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Everything below is optional — these are the defaults.
# ---------------------------------------------------------------------------

# The hostile legacy target application.
TARGET_APP_PORT=3100

# Operator console for human escalation.
OPERATOR_PORT=3200
# Name recorded against interventions you resolve, for the audit trail.
OPERATOR_NAME=local-operator

# Guardrail configuration: allowlist, risk dispositions, redaction patterns.
POLICY_PATH=policy.yaml

# Capability store. Artifacts live at <ARTIFACTS_DIR>/<capability-id>/v<N>.json
ARTIFACTS_DIR=artifacts

# Run logs, screenshots and DOM snapshots.
RUNS_DIR=runs

# File-backed intervention queue, shared between the replay engine and the
# operator console. They are separate processes; this is how they talk.
INTERVENTIONS_DIR=runs/interventions

# ---------------------------------------------------------------------------
# Deliberately NOT here: credentials for the target application.
# ---------------------------------------------------------------------------
# The demo app accepts any operator ID and password. Against a real system these
# would come from a secrets manager at run time, and policy.yaml lists them under
# `redaction.secretEnvVars` so their values are scrubbed if they ever surface in
# a log. Password fields are also read as `undefined` by the perception layer, so
# no code path can capture one in the first place.
