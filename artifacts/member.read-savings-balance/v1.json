{
  "schemaVersion": "1.0",
  "capability": {
    "id": "member.read-savings-balance",
    "version": 1,
    "name": "Read member savings balance",
    "description": "Look up a member by their 6-digit member number in CoreVue and return the current balance of their S1 savings share account.",
    "status": "approved"
  },
  "app": {
    "appId": "corevue",
    "vendor": "meridian-systems",
    "variantOf": null,
    "tenantId": null,
    "entryUrl": "http://localhost:3100"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "description": "The member's 6-digit CoreVue member number.",
      "required": true,
      "pattern": "^\\d{6}$",
      "sensitivity": "pii"
    },
    "expectedName": {
      "type": "string",
      "description": "Optional. Part of the member's name as the caller knows it, e.g. \"Rosa\". When supplied, the capability asserts the record on screen belongs to that person before reading anything off it, and returns MEMBER_NAME_MISMATCH if it does not. Omit it to skip the check.",
      "required": false,
      "sensitivity": "pii"
    },
    "operatorId": {
      "type": "string",
      "description": "Operator ID for the CoreVue sign-on. Supplied by the runtime environment, never by the caller.",
      "required": true,
      "sensitivity": "secret",
      "source": "runtime",
      "env": "COREVUE_OPERATOR_ID"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Password for the CoreVue operator sign-on. Supplied by the runtime environment, never by the caller.",
      "required": true,
      "sensitivity": "secret",
      "source": "runtime",
      "env": "COREVUE_OPERATOR_PASSWORD"
    }
  },
  "outputs": {
    "savingsBalance": {
      "type": "money",
      "description": "Current balance of the S1 savings share account, without the currency symbol.",
      "sensitivity": "pii"
    },
    "memberName": {
      "type": "string",
      "description": "Name on the member record that was actually read, as displayed by CoreVue.",
      "sensitivity": "pii"
    }
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member record exists with that member number. This is a legitimate answer, not a failure.",
      "terminal": true
    },
    {
      "code": "MEMBER_NUMBER_INVALID",
      "description": "The member number was rejected by the application's own validation.",
      "terminal": true
    },
    {
      "code": "ACCESS_DENIED",
      "description": "The operator's role is not authorised to view this member record.",
      "terminal": true
    },
    {
      "code": "MEMBER_NAME_MISMATCH",
      "description": "The member number resolved to a different person than the caller named. Reading this record would be acting on the wrong account, so the run stops without returning a balance."
    }
  ],
  "preconditions": [],
