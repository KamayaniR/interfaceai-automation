{
  "schemaVersion": "1.0",
  "capability": {
    "id": "member.read-checking-balance",
    "version": 1,
    "name": "Read member checking (D1) balance",
    "description": "Signs on to the CoreVue back-office console, looks up a member by member number, and reads the Checking (D1) current balance (plus the member name) from the Member Detail screen. Read-only: no records are modified.",
    "status": "approved"
  },
  "app": {
    "appId": "corevue",
    "vendor": "meridian-systems",
    "variantOf": null,
    "tenantId": null,
    "entryUrl": "http://localhost:3100"
  },
  "inputs": {
    "operatorId": {
      "type": "string",
      "description": "Operator ID used to sign on to the CoreVue console. Supplied by the runtime environment, never by the caller.",
      "required": true,
      "sensitivity": "secret",
      "source": "runtime",
      "env": "COREVUE_OPERATOR_ID"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Password for the operator sign-on. Supplied by the runtime environment, never by the caller.",
      "required": true,
      "sensitivity": "secret",
      "source": "runtime",
      "env": "COREVUE_OPERATOR_PASSWORD"
    },
    "memberNumber": {
      "type": "string",
      "description": "The member number to look up.",
      "required": true,
      "pattern": "^\\d{6}$",
      "sensitivity": "pii"
    },
    "expectedName": {
      "type": "string",
      "description": "Optional. Part of the member's name as the caller knows it, e.g. \"Rosa\". When supplied, the capability asserts the record on screen belongs to that person before reading anything off it, and returns MEMBER_NAME_MISMATCH if it does not. Omit it to skip the check.",
      "required": false,
      "sensitivity": "pii"
    }
  },
  "outputs": {
    "checkingBalance": {
      "type": "money",
      "description": "Current balance of the member's Checking (D1) share account, without currency symbol.",
      "sensitivity": "pii"
    },
    "memberName": {
      "type": "string",
      "description": "Name on the member record that was actually read, as displayed by CoreVue.",
      "sensitivity": "pii"
    }
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member record exists for the supplied member number, so no balances can be returned.",
      "terminal": true
    },
    {
      "code": "MEMBER_NAME_MISMATCH",
      "description": "The member number resolved to a different person than the caller named. Reading this record would be acting on the wrong account, so the run stops without returning a balance."
    }
  ],
  "preconditions": [],
  "steps": [
    {
      "id": "s01",
      "intent": "Open the corevue entry point",
      "action": {
        "kind": "navigate",
        "url": "http://localhost:3100"
      },
      "risk": "safe",
      "onCondition": []
    },
    {
      "id": "s02",
      "intent": "Enter the operator ID to sign on to the console",
      "action": {
        "kind": "type",
        "value": "{{operatorId}}",
        "clearFirst": true
      },
      "target": {
        "framePath": [
          "frame"
        ],
        "candidates": [
          {
            "by": "role-name",
            "role": "textbox",
            "name": "Operator ID",
            "nameIsSubstring": false
          },
          {
            "by": "label-proximity",
            "labelText": "Operator ID",
            "direction": "right",
            "index": 0
          },
          {
            "by": "role-name",
            "role": "textbox",
            "name": "Operator ID",
            "nameIsSubstring": true
          },
          {
            "by": "structural",
            "formIndex": -1,
            "controlIndex": 0
          }
        ],
        "fingerprint": {
          "tagName": "input",
          "inputType": "text",
          "attrs": {
            "name": "f_01",
            "type": "text"
          }
        }
      },
      "risk": "safe",
      "onCondition": [
        {
          "when": {
            "id": "member-name-mismatch",
            "anyOf": [
              {
                "kind": "text-absent",
                "text": "{{expectedName}}",
                "framePath": [
                  "content"
                ],
                "ignoreCase": true
              }
            ]
          },
          "then": {
            "then": "business-outcome",
            "outcomeCode": "MEMBER_NAME_MISMATCH",
            "message": "The record on screen is not the person the caller named. Stopping before reading anything off the wrong account."
          }
        },
        {
          "when": {
            "id": "member-not-found",
            "anyOf": [
              {
                "kind": "text-present",
                "text": "Member not found"
              }
            ]
          },
          "then": {
            "then": "business-outcome",
            "outcomeCode": "MEMBER_NOT_FOUND"
          }
        },
        {
          "when": {
            "id": "app-error",
            "anyOf": [
              {
                "kind": "text-present",
                "text": "HTTP 500 — Internal Server Error"
              },
              {
                "kind": "text-present",
                "text": "SqlSessionException"
              }
            ]
          },
          "then": {
            "then": "escalate",
            "reason": "the application returned a server error (HTTP 500). This is the app being broken right now, not the app answering the question — so it needs a person to decide whether to retry, wait, or raise it with the vendor, rather than an automated retry loop against an unhealthy system."
          }
        }
      ]
    },
