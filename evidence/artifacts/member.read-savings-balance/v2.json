{
  "schemaVersion": "1.0",
  "capability": {
    "id": "member.read-savings-balance",
    "version": 2,
    "name": "Read member savings balance",
    "description": "Signs on to the CoreVue 7.2 back-office console, looks up a member by member number via Member Lookup, and returns the current balance of their Savings (S1) share account along with the member name shown on the Member Detail screen. Read-only: no records are modified. Note: the behaviour for a non-existent member number was deliberately not exercised during recording (probing it would have polluted the replayable flow), so no MEMBER_NOT_FOUND outcome text is declared yet.",
    "status": "draft"
  },
  "app": {
    "appId": "corevue",
    "vendor": "meridian-systems",
    "variantOf": null,
    "tenantId": null,
    "entryUrl": "http://localhost:3100"
  },
  "inputs": {
    "operatorId": {
      "type": "string",
      "description": "Operator ID used to sign on to the CoreVue console.",
      "required": true,
      "sensitivity": "secret"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Password for the operator sign-on.",
      "required": true,
      "sensitivity": "secret"
    },
    "memberNumber": {
      "type": "string",
      "description": "The credit union member number to look up.",
      "required": true,
      "pattern": "^\\d{6}$",
      "sensitivity": "pii"
    }
  },
  "outputs": {
    "savingsBalance": {
      "type": "money",
      "description": "Current balance of the member's Savings (S1) share account, without currency symbol (e.g. 4,182.55).",
      "sensitivity": "pii"
    },
    "memberName": {
      "type": "string",
      "description": "Member name as shown on the Member Detail screen, in LAST, FIRST M format.",
      "sensitivity": "pii"
    }
  },
